# ==============================================================================
# Liara Helper Agent - Environment Configuration (Google Gemini API)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google Gemini LLM & Embeddings API
# ------------------------------------------------------------------------------
# Get your API key from Google AI Studio: https://aistudio.google.com/app/apikey
LLM_API_KEY=YOUR_GOOGLE_GEMINI_API_KEY_HERE

# Google Gemini OpenAI-compatible base URL:
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Google Gemini Chat Model (e.g. gemini-2.5-flash, gemini-1.5-flash, gemini-2.0-flash)
LLM_CHAT_MODEL=gemini-2.5-flash

# Google Gemini Embedding Model
LLM_EMBEDDING_MODEL=text-embedding-004

# Dimension for text-embedding-004 is 768 (use 1536 if using OpenAI)
EMBEDDING_DIM=768

# Optional: HTTP/HTTPS proxy to access Google APIs if you are behind a proxy/VPN
# LLM_PROXY=http://127.0.0.1:10809
# HTTPS_PROXY=http://127.0.0.1:10809

# ------------------------------------------------------------------------------
# 2. Server & Security Settings
# ------------------------------------------------------------------------------
PORT=8080
RATE_LIMIT_RPM=60
CACHE_TTL_MINUTES=60
JWT_SECRET=liara-agent-jwt-super-secret-key-2026

# ------------------------------------------------------------------------------
# 3. Documentation & Vector Store Paths
# ------------------------------------------------------------------------------
REPO_DIR=data/docs
DOCS_DIR=data/docs/src/pages
INDEX_PATH=data/index.json
WEBHOOK_SECRET=your_github_webhook_secret_here

# ------------------------------------------------------------------------------
# 4. Database & Admin User Credentials
# ------------------------------------------------------------------------------
DATABASE_URL=postgres://liara:liarapass@localhost:5432/liaradb?sslmode=disable
ADMIN_EMAIL=admin@liara.ir
ADMIN_PASSWORD=Admin@Liara2026!
